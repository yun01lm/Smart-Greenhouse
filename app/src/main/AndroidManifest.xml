<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 相机权限（病虫害诊断拍照） -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 存储权限（保存诊断图片） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- 录音权限（语音问答） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 通知权限（Android 13+ 离线/告警推送，F2） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GreenhouseApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartGreenhouse"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- 启动页 -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartGreenhouse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 主界面 -->
        <activity
            android:name=".ui.common.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse" />

        <!-- 员工管理 (R26 棚主端) -->
        <activity
            android:name=".ui.employee.EmployeeManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse"
            android:parentActivityName=".ui.common.MainActivity" />

        <!-- 预警详情 -->
        <activity
            android:name=".ui.alert.AlertDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse"
            android:parentActivityName=".ui.common.MainActivity" />

        <!-- 设备控制记录 -->
        <activity
            android:name=".ui.control.ControlLogActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse"
            android:parentActivityName=".ui.common.MainActivity" />

        <!-- 阈值设置 -->
        <activity
            android:name=".ui.alert.ThresholdSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse"
            android:parentActivityName=".ui.common.MainActivity" />

        <!-- 诊断结果 -->
        <activity
            android:name=".ui.diagnosis.DiagnosisResultActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse"
            android:parentActivityName=".ui.common.MainActivity" />

        <!-- 历史数据 -->
        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse"
            android:parentActivityName=".ui.common.MainActivity" />

        <!-- 长势评估 -->
        <activity
            android:name=".ui.growth.GrowthActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse"
            android:parentActivityName=".ui.common.MainActivity" />

        <!-- 健康评分详情 -->
        <activity
            android:name=".ui.health.HealthActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse"
            android:parentActivityName=".ui.common.MainActivity" />

        <!-- 专家列表 (F10) -->
        <activity
            android:name=".ui.expert.ExpertListActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse" />

        <!-- 我的咨询（会话列表，APP-D02） -->
        <activity
            android:name=".ui.expert.ConversationListActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse" />

        <!-- 专家聊天 (F10) -->
        <activity
            android:name=".ui.expert.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse"
            android:windowSoftInputMode="adjustResize" />

        <!-- 授权管理 (F10) -->
        <activity
            android:name=".ui.expert.AuthorizationActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartGreenhouse" />

        <!-- FileProvider（拍照） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 离线/告警推送监控服务（F2） -->
        <service
            android:name=".service.MonitorService"
            android:exported="false" />

        <!-- 农事日历（F3） -->
        <activity
            android:name=".ui.farming.FarmingCalendarActivity"
            android:parentActivityName=".ui.common.MainActivity" />

        <!-- 农事提醒通知接收器（F3） -->
        <receiver
            android:name=".ui.farming.ReminderReceiver"
            android:exported="false" />

        <!-- 预警规则管理（第 1 项） -->
        <activity
            android:name=".ui.alert.AlertRuleActivity"
            android:parentActivityName=".ui.common.MainActivity" />

        <!-- 多棚对比（第 2 项） -->
        <activity
            android:name=".ui.compare.CompareActivity"
            android:parentActivityName=".ui.common.MainActivity" />

    </application>
</manifest>
