# ===========================================
# 智慧大棚AIoT系统 — 环境变量模板
# ===========================================
# 复制此文件为 .env 并填入真实值
# .env 文件绝对不能提交到 Git！

# ===== 数据库 =====
MYSQL_ROOT_PASSWORD=root

# ===== InfluxDB =====
INFLUX_USER=greenhouse_admin
INFLUX_PASSWORD=greenhouse123
INFLUX_TOKEN=dev-token-greenhouse-2026

# ===== MQTT（生产阶段启用） =====
# MQTT_USER=greenhouse
# MQTT_PASSWORD=your_mqtt_password

# ===== 第三方API =====
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key
XUNFEI_APP_ID=your_xunfei_app_id
XUNFEI_API_KEY=your_xunfei_api_key
XUNFEI_API_SECRET=your_xunfei_api_secret
DEEPSEEK_API_KEY=your_deepseek_api_key
SILICONFLOW_API_KEY=your_siliconflow_api_key
QWEATHER_API_KEY=your_qweather_api_key

# ===== frp内网穿透 =====
FRP_SERVER_ADDR=your_frp_server_address
FRP_SERVER_PORT=7000
FRP_TOKEN=your_frp_token
